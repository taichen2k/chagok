rules_version = '2';
// 차곡차곡 보안 규칙: 차량(cars) 문서의 members에 들어 있는 사람만 그 차량과 기록을 읽고 쓸 수 있음
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(carId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/cars/$(carId)).data.members;
    }
    match /cars/{carId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.owner == resource.data.owner;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      match /{sub}/{recId} {
        allow read, write: if (sub == 'fuels' || sub == 'services') && isMember(carId);
      }
    }
  }
}
